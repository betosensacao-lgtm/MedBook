# ──────────────────────────────────────────────
#  MedBook — Environment Variables
#  Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
# Pooler (used by the app at runtime — port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Direct connection (used by Drizzle migrations — no pooler, port 5432)
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# AI / LLM
# Primary: Groq (fast, free tier available) — https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key
# Model: llama-3.3-70b-versatile (recommended — stable and capable)
GROQ_MODEL=llama-3.3-70b-versatile
# Optional fallback: OpenRouter
# OPENROUTER_API_KEY=sk-or-your-key
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Resend (transactional email) — https://resend.com
RESEND_API_KEY=re_your_key
# Use "onboarding@resend.dev" for testing, or a verified domain in production
EMAIL_FROM=MedBook <onboarding@resend.dev>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron (protects /api/cron/reminders — Vercel Cron sends this as Bearer token)
CRON_SECRET=change-me-to-a-long-random-string

# ──────────────────────────────────────────────
#  WhatsApp Business API (ready for integration)
#  Obtain credentials from Meta Business Manager:
#  https://developers.facebook.com/apps/
# ──────────────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# Meta App Secret (for webhook signature verification)
META_APP_SECRET=your-meta-app-secret
